# Copy to .env and fill in. Never commit .env.

# RPC endpoints used for chain reads and fork simulation (Anvil).
# e.g. https://eth-mainnet.g.alchemy.com/v2/<key>, base-mainnet, arb-mainnet
ETH_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# Etherscan API v2 (one key for all chains): approval history and contract verification.
ETHERSCAN_API_KEY=

# Postgres: scan cache (ADR 0010).
DATABASE_URL=postgres://plaintx:plaintx@localhost:5432/plaintx

# Redis: rate limits shared by every server (ADR 0012). Unset: each server limits on its own.
REDIS_URL=redis://localhost:6379
# Proxies in front of the app that append to X-Forwarded-For, e.g. 1 behind one load balancer.
# 0 trusts the header as sent, which only suits local development.
TRUSTED_PROXY_COUNT=0
# Etherscan calls per second allowed by the API plan, shared by every server. Free tier: 5.
ETHERSCAN_CALLS_PER_SECOND=5

# LLM used only to *explain* verdicts, never to decide them.
ANTHROPIC_API_KEY=
